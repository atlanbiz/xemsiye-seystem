    "alerts.serverHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rules are checked on the server by the evaluate-alerts Edge Function on a schedule. Each rule fires at most once every 6 hours and posts a notification."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قائىدىلەر مۇلازىمېتىردا evaluate-alerts Edge Function ئارقىلىق ۋاقىت جەدۋىلى بويىچە تەكشۈرۈلىدۇ. ھەر بىر قائىدە 6 سائەتتە ئەڭ كۆپ بىر قېتىم ئۇقتۇرۇش ئەۋەتىدۇ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفحص القواعد على الخادم بواسطة دالة evaluate-alerts وفق جدول زمني. تُطلق كل قاعدة إشعارًا مرة واحدة على الأكثر كل 6 ساعات."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar sunucuda evaluate-alerts Edge Function tarafından zamanlanmış olarak kontrol edilir. Her kural en fazla 6 saatte bir bildirim gönderir."
          }
        }
      }
    },
