        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuralı Düzenle"
          }
        }
      }
    },
    "alerts.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No rules yet. Create one to start monitoring."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تېخى قائىدە يوق. نازارەتنى باشلاش ئۈچۈن بىرنى قۇرۇڭ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد قواعد بعد. أنشئ قاعدة لبدء المراقبة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kural yok. İzlemeye başlamak için bir kural oluşturun."
          }
        }
      }
    },
    "alerts.enableNotifs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on notifications"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئۇقتۇرۇشنى قوزغىتىش"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفعيل الإشعارات"
