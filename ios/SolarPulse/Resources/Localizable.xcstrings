    },
    "alerts.d.device_efficiency_below": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any device whose efficiency is below the threshold."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئۈنۈمى چەك قىممىتىدىن تۆۋەن ھەرقانداق ئۈسكۈنە."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي جهاز تقل كفاءته عن الحد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verimi eşiğin altında olan her cihaz."
          }
        }
      }
    },
    "alerts.d.device_health_below": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any device whose health score is below the threshold."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سالامەتلىك نومۇرى چەك قىممىتىدىن تۆۋەن ھەرقانداق ئۈسكۈنە."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي جهاز تقل درجة سلامته عن الحد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık puanı eşiğin altında olan her cihaz."
          }
        }
      }
    },
    "alerts.d.device_offline_minutes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline devices not seen for longer than the threshold."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "چەك قىممىتىدىن ئۇزۇن ۋاقىت كۆرۈنمىگەن تورسىز ئۈسكۈنىلەر."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة غير المتصلة التي لم تُرصد لمدة تتجاوز الحد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşikten uzun süredir görülmeyen çevrimdışı cihazlar."
          }
        }
      }
    },
    "alerts.d.invoice_overdue_days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overdue invoices more than the threshold past their due date."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "مۆھلىتىدىن چەك قىممىتىدىن ئارتۇق كۈن ئۆتۈپ كەتكەن تالونلار."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفواتير المتأخرة التي تجاوزت تاريخ استحقاقها بأكثر من الحد."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vadesini eşikten fazla gün geçmiş gecikmiş faturalar."
          }
        }
      }
    },
    "alerts.d.site_offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fires while a site’s status is Offline."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئىستانسا ھالىتى «تورسىز» بولغاندا ئىجرا بولىدۇ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلق ما دامت حالة المحطة «غير متصل»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santralin durumu Çevrimdışı olduğu sürece tetiklenir."
          }
        }
      }
    },
    "alerts.d.site_yield_below": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today’s energy ÷ capacity (kWh/kWp). Checked after 14:00 local time."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۈگۈنكى ئېنېرگىيە ÷ سىغىم (kWh/kWp). يەرلىك ۋاقىت 14:00 دىن كېيىن تەكشۈرۈلىدۇ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاقة اليوم ÷ القدرة (kWh/kWp). يُفحص بعد الساعة 14:00 بالتوقيت المحلي."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünkü enerji ÷ kapasite (kWh/kWp). Yerel saatle 14:00’ten sonra kontrol edilir."
          }
        }
      }
    },
    "alerts.demoHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo mode: rules are checked in your browser when the app opens and every 3 minutes. Each rule fires at most once every 6 hours and posts a notification."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سىناق ھالىتى: قائىدىلەر ئەپ ئېچىلغاندا ۋە ھەر 3 مىنۇتتا توركۆرگۈچىڭىزدە تەكشۈرۈلىدۇ. ھەر بىر قائىدە 6 سائەتتە ئەڭ كۆپ بىر قېتىم ئۇقتۇرۇش ئەۋەتىدۇ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوضع التجريبي: تُفحص القواعد في متصفحك عند فتح التطبيق وكل 3 دقائق. تُطلق كل قاعدة إشعارًا مرة واحدة على الأكثر كل 6 ساعات."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demo modu: kurallar uygulama açıldığında ve her 3 dakikada bir tarayıcınızda kontrol edilir. Her kural en fazla 6 saatte bir bildirim gönderir."
          }
        }
      }
    },
    "alerts.edit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit Rule"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قائىدىنى تەھرىرلەش"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
