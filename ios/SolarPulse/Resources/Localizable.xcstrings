        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تور ئۆتكىلىڭىز ياكى MQTT كۆۋرۈكىڭىز JSON سانلىق مەلۇماتنى x-ingest-token بېشى بىلەن بۇ ئادرېسقا POST قىلىدۇ."
