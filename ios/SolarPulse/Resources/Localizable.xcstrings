    "alerts.enableNotifsBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a banner on this device when a rule fires. You can change this anytime in Settings."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "قائىدە قوزغالغاندا بۇ ئۈسكۈنىدە ئۇقتۇرۇش كۆرسىتىلىدۇ. خالىغان ۋاقىتتا تەڭشەكلەردە ئۆزگەرتەلەيسىز."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على إشعار على هذا الجهاز عند إطلاق قاعدة. يمكنك تغيير ذلك في أي وقت من الإعدادات."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kural tetiklendiğinde bu cihazda bildirim alın. Bunu istediğiniz zaman Ayarlar'dan değiştirebilirsiniz."
          }
        }
      }
    },
