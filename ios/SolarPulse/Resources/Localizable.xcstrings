    "fin.model": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Year-1 energy is the simulated production of the last 365 days. Each year output degrades and the tariff escalates by the site’s rates; O&M is subtracted yearly."
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "1-يىللىق ئېنېرگىيە ئاخىرقى 365 كۈنلۈك سىمۇلياتسىيە ھاسىلاتىدىن ئېلىنىدۇ. ھەر يىلى ھاسىلات تۆۋەنلەيدۇ، توك باھاسى ئىستانسىنىڭ نىسبىتى بويىچە ئۆسىدۇ؛ ئاسراش خىراجىتى ھەر يىلى چىقىرىۋېتىلىدۇ."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طاقة السنة الأولى هي الإنتاج المحاكى لآخر 365 يومًا. يتراجع الإنتاج وترتفع التعرفة سنويًا وفق معدلات كل محطة، وتُطرح تكاليف التشغيل والصيانة كل سنة."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. yıl enerjisi son 365 günün simüle edilmiş üretimidir. Her yıl üretim azalır ve tarife santralin oranlarına göre artar; işletme-bakım maliyeti her yıl düşülür."
          }
        }
      }
    },
