// Copy to Secrets.xcconfig (git-ignored) and fill in your project's values,
// then rebuild. Find them in Supabase → Project Settings → API.
//
// Note: "//" starts a comment in .xcconfig files, so write the URL with $() between the slashes.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-public-key
